{
   "name": "dependabot-vuln-viewer",
   "version": "1.0.0",
   "description": "Quick overview of Dependabot vulnerabilites of multiple repositories",
   "repository": {
      "type": "git",
      "url": "git+ssh://git@github.com/nyg/dependabot-vuln-viewer.git"
   },
   "keywords": [
      "dependabot",
      "vulnerabilities",
      "github",
      "graphql",
      "log4shell"
   ],
   "author": "nyg",
   "packageManager": "pnpm@11.24.0",
   "license": "MIT",
   "bugs": {
      "url": "https://github.com/nyg/dependabot-vuln-viewer/issues"
   },
   "scripts": {
      "dev": "next dev",
      "debug": "NODE_OPTIONS='--inspect' next dev",
      "lint": "eslint . --fix"
   },
   "dependencies": {
      "@apollo/client": "4.2.12",
      "github-markdown-css": "5.9.0",
      "graphql": "17.0.2",
      "marked-react": "4.0.0",
      "next": "16.3.3",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "rxjs": "7.8.2"
   },
   "devDependencies": {
      "@tailwindcss/postcss": "4.3.3",
      "eslint": "9.39.5",
      "eslint-config-next": "16.3.3",
      "postcss": "8.5.26",
      "tailwindcss": "4.3.3"
   },
   "pnpm": {
      "overrides": {
         "baseline-browser-mapping": "latest"
      }
   }
}
